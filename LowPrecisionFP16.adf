DM ReadLowPrecisionFP16();
DM ReadLowPrecisionFP16FP64();

group fp32_readwrite {
    instruction = {flw, fsw, fmadd_s, fmsub_s, fnmsub_s,
                    fnmadd_s, fadd_s, fsub_s, fmul_s, fdiv_s,
                    fsqrt_s, fsgnj_s, fsgnjn_s, fsgnjx_s, fmin_s,
                    fmax_s
    };
}

group fp32_read {
    instruction = {fcvt_w_s, fcvt_wu_s, fmv_x_w, feq_s, flt_s,
                    fle_s, fclass_s, fcvt_l_s, fcvt_lu_s
    };
}

group fp32_write {
    instruction = {fcvt_s_w, fcvt_s_wu, fmv_w_x, fcvt_s_l,
                    fcvt_s_lu};
}

group fp64_readwrite {
    instruction = {fld, fsd, fmadd_d, fmsub_d, fnmsub_d,
                    fnmadd_d, fadd_d, fsub_d, fmul_d, fdiv_d,
                    fsqrt_d, fsgnj_d, fsgnjn_d, fsgnjx_d, fmin_d,
                    fmax_d
    };
}

group fp64_read {
    instruction = {fcvt_w_d, fcvt_wu_d, fmv_x_d, fmvh_x_d, feq_d,
                    flt_d, fle_d, fclass_d, fcvt_l_d, fcvt_lu_d
    };
}

group fp64_write {
    instruction = {fcvt_d_w, fcvt_d_wu, fmv_d_x, fmvp_d_x, fcvt_d_l,
                    fcvt_d_lu
    };
}

group fp32_to_fp64 {
    instruction = {fcvt_d_s};
}

group fp64_to_fp32 {
    instruction = {fcvt_s_d};
}

approximation LOWPRECISIONFP16 {
    initial = off;

    group fp32_readwrite {
        regbank_read = ReadLowPrecisionFP16();
        regbank_write = ReadLowPrecisionFP16();
    }

    group fp32_read {
        regbank_read = ReadLowPrecisionFP16();
    }

    group fp32_write {
        regbank_write = ReadLowPrecisionFP16();
    }

    group fp64_readwrite {
        regbank_read = ReadLowPrecisionFP16FP64();
        regbank_write = ReadLowPrecisionFP16FP64();
    }

    group fp64_read {
        regbank_read = ReadLowPrecisionFP16FP64();
    }

    group fp64_write {
        regbank_write = ReadLowPrecisionFP16FP64();
    }

    group fp32_to_fp64 {
        regbank_read = ReadLowPrecisionFP16();
        regbank_write = ReadLowPrecisionFP16FP64();
    }

    group fp64_to_fp32 {
        regbank_read = ReadLowPrecisionFP16FP64();
        regbank_write = ReadLowPrecisionFP16();
    }
}
